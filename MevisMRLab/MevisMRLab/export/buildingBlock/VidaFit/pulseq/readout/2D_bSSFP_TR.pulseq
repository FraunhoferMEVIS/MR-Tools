# Format of blocks:
# D RF GX GY GZ ADC EXT
[BLOCKS]
1 2680 1 0 0 1 0 0
2 1620 0 2 3 4 0 0
3 2080 0 5 0 0 1 9
4 1620 0 2 6 4 0 0

# Format of RF events:
# id amplitude mag_id phase_id time_id delay freq phase
# ..        Hz   ....     ....    ....    us   Hz   rad
[RF]
1 507.584728 1 2 0 60 0.000000 0.000000

# Format of gradients:
# id amplitude shape_id time_id delay
# ..      Hz/m       ..      ..    us
[GRADIENTS]
1 406250.0057672 3 0 0
2 184782.5936621 4 0 0
3 181159.4122296 4 0 0
4 385643.12943818 4 0 0
5 249999.98717383 5 0 0
6 181159.4122296 6 0 0

# Format of ADC events:
# id num dwell delay freq phase
# ..  ..    ns    us   Hz   rad
[ADC]
1 256 7812 40 0.000000 0.000000

# Format of extension lists:
# id type ref next_id
# next_id of 0 terminates the list
# Extension list is followed by extension specifications
[EXTENSIONS]
1 1 9 0
2 1 8 1
3 1 7 2
4 1 6 3
5 1 5 4
6 1 4 5
7 1 3 6
8 1 2 7
9 1 1 8

# Extension specification for setting labels:
# id set labelstring
extension LABELSET 1
1 0 LIN
2 0 PAR
3 0 SLC
4 0 SEG
5 0 REP
6 0 AVG
7 0 SET
8 0 ECO
9 0 PHS

# Extension specification for incrementing labels:
# id inc labelstring
extension LABELINC 2

