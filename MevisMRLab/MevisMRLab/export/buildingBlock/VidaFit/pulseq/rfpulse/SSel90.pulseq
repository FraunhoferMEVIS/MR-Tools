major 1
minor 4
revision 0

[DEFINITIONS]
GradientRasterTime 1e-005
RadiofrequencyRasterTime 1e-005
AdcRasterTime 1e-006
BlockDurationRaster 1e-006
FOV 0.256 0.256 0.005
TotalDuration 0.00341

# Format of blocks:
# D RF GX GY GZ ADC EXT
[BLOCKS]
1 3410 1 0 0 1 0 0

# Format of RF events:
# id amplitude mag_id phase_id time_id delay freq phase
# ..        Hz   ....     ....    ....    us   Hz   rad
[RF]
1 507.584728 1 2 0 60 0.000000 2.042035

# Format of gradients:
# id amplitude shape_id time_id delay
# ..      Hz/m       ..      ..    us
[GRADIENTS]
1 1492346.9634367 3 0 0

# Format of ADC events:
# id num dwell delay freq phase
# ..  ..    ns    us   Hz   rad
[ADC]

# Format of extension lists:
# id type ref next_id
# next_id of 0 terminates the list
# Extension list is followed by extension specifications
[EXTENSIONS]

# Extension specification for setting labels:
# id set labelstring
extension LABELSET 1

# Extension specification for incrementing labels:
# id inc labelstring
extension LABELINC 2

