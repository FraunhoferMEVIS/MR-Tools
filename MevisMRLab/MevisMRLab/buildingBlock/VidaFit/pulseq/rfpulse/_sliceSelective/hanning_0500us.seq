# Format of blocks:
# NUM DUR RF  GX  GY  GZ  ADC  EXT
[BLOCKS]
1 63   1   1   2   3  0  0
2 16   0   4   5   6  0  0

# Format of RF events:
# id amplitude mag_id phase_id time_shape_id delay freq phase
# ..        Hz   ....     ....          ....    us   Hz   rad
[RF]
1      {rf_amp} 1 2 0 100 {rf_freq} {rf_phase}

# Format of trapezoid gradients:
# id amplitude rise flat fall delay
# ..      Hz/m   us   us   us    us
[TRAP]
 1    {int(gradX_amp)} 30  500  30  70
 2    {int(gradY_amp)} 30  500  30  70
 3    {int(gradZ_amp)} 30  500  30  70
 4    {int(-gradX_amp*530/(2*80))} 80 0 80 0
 5    {int(-gradY_amp*530/(2*80))} 80 0 80 0
 6    {int(-gradZ_amp*530/(2*80))} 80 0 80 0

