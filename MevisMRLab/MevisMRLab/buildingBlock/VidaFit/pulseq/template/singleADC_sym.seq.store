#   "gradY_amp":    { "type": "float", "default": 4.0, "min": -40.0, "max": 40.0, "step": 0.1, "unit": "mT/m", "pulseq_value": "(seq_loop_counter-seq_loop_length/2)*200000.0/seq_loop_length",  "pulseq_unit": "Hz/m", "description":"gradient amplitude in y direction" }
